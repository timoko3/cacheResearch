# Focus on defects rather than imposing another naming/style convention.
Checks: >-
  -*,
  clang-analyzer-*,
  bugprone-assert-side-effect,
  bugprone-branch-clone,
  bugprone-dangling-handle,
  bugprone-fold-init-type,
  bugprone-inaccurate-erase,
  bugprone-infinite-loop,
  bugprone-integer-division,
  bugprone-macro-parentheses,
  bugprone-macro-repeated-side-effects,
  bugprone-misplaced-widening-cast,
  bugprone-move-forwarding-reference,
  bugprone-sizeof-*,
  bugprone-string-*,
  bugprone-suspicious-*,
  bugprone-swapped-arguments,
  bugprone-undefined-memory-manipulation,
  bugprone-use-after-move
# Optional residency and exception propagation need a separate contract review;
# do not enable every bugprone check indiscriminately.
WarningsAsErrors: '*'
HeaderFilterRegex: '(^|/)(cache\.h|cache/.*\.h|cacheParser\.h|cacheSystem\.h|tests/.*\.h)$'
SystemHeaders: false
FormatStyle: file
