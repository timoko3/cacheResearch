# Reproduce the compiler environment without inheriting project targets or options.
if(NOT [==[@CMAKE_TOOLCHAIN_FILE@]==] STREQUAL "")
    set(CMAKE_TOOLCHAIN_FILE [==[@CMAKE_TOOLCHAIN_FILE@]==] CACHE STRING "Verification compiler setting" FORCE)
endif()
if(NOT [==[@CMAKE_SYSROOT@]==] STREQUAL "")
    set(CMAKE_SYSROOT [==[@CMAKE_SYSROOT@]==] CACHE STRING "Verification compiler setting" FORCE)
endif()
if(NOT [==[@CMAKE_CXX_FLAGS@]==] STREQUAL "")
    set(CMAKE_CXX_FLAGS [==[@CMAKE_CXX_FLAGS@]==] CACHE STRING "Verification compiler setting" FORCE)
endif()
