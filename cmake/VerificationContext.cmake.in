if(NOT [==[@CMAKE_OSX_DEPLOYMENT_TARGET@]==] STREQUAL "")
    set(CMAKE_OSX_DEPLOYMENT_TARGET [==[@CMAKE_OSX_DEPLOYMENT_TARGET@]==] CACHE STRING "Verification compiler setting" FORCE)
endif()
if(NOT [==[@CMAKE_CXX_COMPILER_TARGET@]==] STREQUAL "")
    set(CMAKE_CXX_COMPILER_TARGET [==[@CMAKE_CXX_COMPILER_TARGET@]==] CACHE STRING "Verification compiler setting" FORCE)
endif()
if(NOT [==[@CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN@]==] STREQUAL "")
    set(CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN [==[@CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN@]==] CACHE STRING "Verification compiler setting" FORCE)
endif()
if(NOT [==[@CMAKE_EXE_LINKER_FLAGS_DEBUG@]==] STREQUAL "")
    set(CMAKE_EXE_LINKER_FLAGS_DEBUG [==[@CMAKE_EXE_LINKER_FLAGS_DEBUG@]==] CACHE STRING "Verification linker setting" FORCE)
endif()
if(NOT [==[@CMAKE_EXE_LINKER_FLAGS_RELEASE@]==] STREQUAL "")
