endif()
if(NOT [==[@CMAKE_EXE_LINKER_FLAGS@]==] STREQUAL "")
    set(CMAKE_EXE_LINKER_FLAGS [==[@CMAKE_EXE_LINKER_FLAGS@]==] CACHE STRING "Verification compiler setting" FORCE)
endif()
if(NOT [==[@CMAKE_MSVC_RUNTIME_LIBRARY@]==] STREQUAL "")
    set(CMAKE_MSVC_RUNTIME_LIBRARY [==[@CMAKE_MSVC_RUNTIME_LIBRARY@]==] CACHE STRING "Verification compiler setting" FORCE)
endif()
if(NOT [==[@CMAKE_OSX_ARCHITECTURES@]==] STREQUAL "")
    set(CMAKE_OSX_ARCHITECTURES [==[@CMAKE_OSX_ARCHITECTURES@]==] CACHE STRING "Verification compiler setting" FORCE)
endif()
if(NOT [==[@CMAKE_OSX_SYSROOT@]==] STREQUAL "")
    set(CMAKE_OSX_SYSROOT [==[@CMAKE_OSX_SYSROOT@]==] CACHE STRING "Verification compiler setting" FORCE)
